# Solo para probar en local con `netlify dev` (la función de alta de usuarios).
# En producción estas variables se configuran en Netlify →
# Site configuration → Environment variables.
#
# La URL y la anon key públicas NO van aquí: están en public/config.js.
SUPABASE_URL=https://pbjthkfiuapwnmwhlrxp.supabase.co

# Supabase → Project Settings → API Keys → service_role (secret).
# Da acceso total a TODO el proyecto compartido (PSI, Arcade, Nupcia…):
# nunca la subas al repo ni la pongas en el navegador.
SUPABASE_SERVICE_ROLE_KEY=
